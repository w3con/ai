{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(__HOME__/Dev/ai/bin/websearch:*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/plan-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/settings-write-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/memory-store-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/coordinator-source-gate.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/card-touch-gate.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'REMINDER on writing style for THIS reply: write in full, connected sentences and developed prose. Never use telegraphic or clipped-fragment style, dropped subjects, or headline-style bullets. Explain terms plainly. This applies to chat answers exactly as much as to documents. Alex has demanded this many times — treat any urge to compress as the cue to slow down and spell it out.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/inbox-stop.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false
  },
  "theme": "auto",
  "preferredNotifChannel": "kitty",
  "skipAutoPermissionPrompt": true
}
