#!/usr/bin/env python3
"""Refuse style guidance duplicated outside the public STYLE.md source.

Usage:
  bin/style-check [--quiet] [extra-root ...]

This command scans the toolkit's instructions and configuration plus explicit
extra roots. It reports matching paths and line numbers without printing source
text. Private project roots are scanned only when listed in private configuration.

Exit codes: 0 clean, 2 bad arguments, 3 a style rule was found outside STYLE.md
or the single-file wiring is broken.
"""

import os
import re
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
STYLE = os.path.join(REPO, "STYLE.md")
sys.path.insert(0, REPO)
try:
    from lib.private_config import load
    PRIVATE_CONFIG = load(REPO)
except Exception:
    PRIVATE_CONFIG = {}

# Generic English style-policy signals.
MARKERS = [
    r"\bslop\b",
    r"\btelegraph",
    r"developed prose",
    r"\bornament",
    r"complete sentence",
    r"every sentence",
    r"short sentences",
    r"small words",
    r"\bmetaphor",
    r"\bacronym",
    r"\babbreviation",
    r"hard line[- ]?(break|wrap)",
    r"line[- ]wrap",
    r"em[- ]dash",
    r"conventional commits",
    r"in chat, (write|give|say)",
    r"(reply|replies|answer|respond).{0,24}\bin russian\b",
    r"how you write",
    r"writing style",
]
# Input-only aliases preserve detection of existing legacy instruction phrases.
LEGACY_STYLE_MARKERS = [
    r"\u0441\u0442\u0438\u043b\u044c (\u043e\u0431\u0449\u0435|\u043f\u0438\u0441\u044c|\u043e\u0442\u0432\u0435|\u0438\u0437\u043b\u043e)",
    r"\u0438\u0441\u043a\u0443\u0441\u0441\u0442\u0432\u0435\u043d\u043d\w* \u043f\u0435\u0440\u0435\u043d\u043e\u0441",
    r"\u043e\u0442\u0432\u0435\u0447\u0430\u0439 \u043d\u0430 \u0440\u0443\u0441\u0441\u043a\u043e\u043c",
    r"\u043f\u0438\u0448\u0438 (\u043f\u043e-\u0440\u0443\u0441\u0441\u043a\u0438|\u043a\u043e\u0440\u043e\u0447\u0435|\u043f\u043e\u043b\u043d\u044b\u043c\u0438)",
    r"\u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u0447\u043d\w* (\u043e\u0431\u0440\u0443\u0431\u043a|\u0442\u0435\u043b\u0435\u0433\u0440\u0430\u043c\u043c)",
]
MARKER_RE = [(m, re.compile(m, re.IGNORECASE)) for m in (*MARKERS, *LEGACY_STYLE_MARKERS)]

# STYLE.md and this checker implement the rule; synchronized vendor content is external.
def exempt(path: str) -> bool:
    base = os.path.basename(path)
    if base in ("STYLE.md", "style-check", "style-migrate"):
        return True
    # A skill synced from the vendor's library is third-party text this configuration did
    # not write and must not edit, so a marker inside one is never a rule of ours living in
    # the wrong place.
    return f"{os.sep}skills{os.sep}synced{os.sep}" in path


SCAN_DIRS = ["memory", "agents", "skills", "commands", "hooks", "templates", "decisions"]
SCAN_FILES = ["CLAUDE.md", "settings.json.template", "ai_readme.md", "readme.md"]
SKIP_DIRS = {".git", "_legacy", "candidates", "node_modules", "worktrees", "__pycache__"}
TEXT_EXT = {".md", ".sh", ".py", ".json", ".template", ".txt", ".yaml", ".yml", ""}

PRIVATE_ROOTS = []


def iter_files(roots):
    for root in roots:
        if os.path.isfile(root):
            yield root
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS and not d.startswith(".")]
            for name in filenames:
                if os.path.splitext(name)[1].lower() in TEXT_EXT:
                    yield os.path.join(dirpath, name)


def scan(roots):
    findings = []
    for path in iter_files(roots):
        if exempt(path):
            continue
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                lines = fh.read().split("\n")
        except (OSError, UnicodeError):
            continue
        for n, line in enumerate(lines, 1):
            for marker, rx in MARKER_RE:
                if rx.search(line):
                    findings.append((path, n, marker))
                    break
    return findings


def wiring_problems():
    problems = []
    if not os.path.isfile(STYLE):
        problems.append("STYLE.md is missing — the single style file does not exist")
        return problems
    claude = os.path.join(REPO, "CLAUDE.md")
    try:
        text = open(claude, encoding="utf-8").read()
    except OSError:
        problems.append("CLAUDE.md could not be read")
        return problems
    if "@STYLE.md" not in text:
        problems.append("CLAUDE.md does not import STYLE.md — add the line `@STYLE.md`")
    return problems


# Only explicitly configured external roots participate; no home-directory crawl occurs.
PROJECT_SEARCH_ROOTS = [os.path.expanduser(p) for p in PRIVATE_CONFIG.get("external_roots", [])]
STYLE_SEARCH_ROOTS = [os.path.expanduser(p) for p in PRIVATE_CONFIG.get("style_roots", [])]
PROJECT_FILES = ["CLAUDE.md", "rules.md", "AGENTS.md", "KB-CONVENTIONS.md"]
PROJECT_DIRS = [os.path.join(".claude", "skills"), os.path.join(".claude", "agents")]


def project_roots():
    seen, out = set(), []
    for base in PROJECT_SEARCH_ROOTS:
        if not os.path.isdir(base):
            continue
        candidates = [base]
        try:
            candidates.extend(os.path.join(base, entry) for entry in os.listdir(base)
                              if os.path.isdir(os.path.join(base, entry)) and
                              not entry.startswith("."))
        except OSError:
            pass
        for project in candidates:
            if os.path.realpath(project) == os.path.realpath(REPO):
                continue
            for name in PROJECT_FILES + PROJECT_DIRS:
                path = os.path.join(project, name)
                real = os.path.realpath(path)
                if os.path.exists(path) and real not in seen:
                    seen.add(real)
                    out.append(path)
    return out


def main(argv):
    quiet = "--quiet" in argv
    args = [a for a in argv if not a.startswith("--")]
    for a in argv:
        if a.startswith("--") and a not in ("--quiet", "--help", "-h"):
            print(f"style-check: unknown option {a}", file=sys.stderr)
            return 2
    if "--help" in argv or "-h" in argv:
        print(__doc__)
        return 0

    roots = [os.path.join(REPO, d) for d in SCAN_DIRS if os.path.isdir(os.path.join(REPO, d))]
    roots += [os.path.join(REPO, f) for f in SCAN_FILES if os.path.isfile(os.path.join(REPO, f))]
    roots += [path for path in STYLE_SEARCH_ROOTS if os.path.exists(path)]
    roots += project_roots()
    roots += [os.path.abspath(a) for a in args if os.path.exists(a)]

    problems = wiring_problems()
    findings = scan(roots)

    if not problems and not findings:
        if not quiet:
            print("style-check: clean — every writing rule lives in STYLE.md and nowhere else.")
        return 0

    print("style-check: the single-style-file rule is broken.", file=sys.stderr)
    for p in problems:
        print(f"  wiring: {p}", file=sys.stderr)
    for path, n, marker in findings:
        rel = os.path.relpath(path, REPO) if path.startswith(REPO) else path
        print(f"  {rel}:{n}  matched /{marker}/", file=sys.stderr)
    if findings:
        print("", file=sys.stderr)
        print("Delete each of these where it stands. If the rule is worth keeping, fold it into", file=sys.stderr)
        print(f"{os.path.relpath(STYLE, REPO)} instead; where it contradicts that file, that file wins.", file=sys.stderr)
    return 3


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
