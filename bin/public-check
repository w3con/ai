BACKSLASH = chr(92)
CYRILLIC = re.compile(f"[{chr(0x0400)}-{chr(0x052F)}]")
SHORT_ESCAPE = re.compile(re.escape(BACKSLASH + "u") + r"([0-9A-Fa-f]{4})")
LONG_ESCAPE = re.compile(re.escape(BACKSLASH + "U") + r"([0-9A-Fa-f]{8})")
