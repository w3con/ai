#!/usr/bin/env python3
"""plan-check — validate a plain plan card and sign it for plan-gate.

Usage:  plan-check <card.md> [--check]

Writes the line `<!-- card:ready -->` at the end of the card when every rule below
holds, and removes any marker already there when one does not. `--check` reports
without touching the file.

For cards that carry a registry identifier and link to requirement, feature and
test pages, use `card-context` instead; this checks the plain shape used by
projects with no task-card registry.

Rules, all of which must hold:
  1. The card records its approval, in either of two shapes. A `**Status:**` line
     says the card is approved or signed off and does not still say it is awaiting
     approval; or the card's YAML frontmatter carries `status:` set to a value that
     means the owner has decided the work will be done (`todo`, `approved`,
     `in_progress`, `done`), as opposed to `idea`, which means it has not.
  2. A section whose heading names what must not be touched exists and is not empty.
  3. A section whose heading names the acceptance criteria exists and is not empty.
  4. A `## Checkpoints` section exists and holds at least one checkpoint.
  5. Every checkpoint line reads `- [ ] N.n — text`, or the same with the card's own
     identifier in front of the number (`- [ ] WEB-1.2 — text`), or either with `[x]`.
  6. Every filesystem path the card names in backticks resolves to a real file.
  7. The word `PLACEHOLDER` appears nowhere in the card. Templates write it into every
     mandatory slot, so one left behind is an unfilled section rather than an answer.

Paths are resolved against, in order: the card's own directory, the repository
root the card declares in a `**Repository the work happens in:** ` line, and the
root of the git repository holding the card. A leading `~` is expanded.
"""

import os
import re
import subprocess
import sys

MARKER = "<!-- card:ready -->"

HEADING = re.compile(r"^#{1,6}\s+(.*?)\s*#*$")
LIST_ITEM = re.compile(r"^\s*[-*]\s")
# `- [ ] 1.2 — …`, or the same with a card identifier in front: `- [ ] WEB-1.2 — …`.
CHECKPOINT = re.compile(
    r"^\s*[-*]\s+\[[ xX]\]\s+(?:[A-Za-z][A-Za-z0-9]*-\d+\.\d+|\d+\.\d+)\s+[—–-]\s+\S"
)
STATUS = re.compile(r"^\*\*Status:\*\*\s*(.+)$", re.MULTILINE)
# `status: todo` inside the YAML frontmatter block at the very top of the file.
FRONTMATTER_STATUS = re.compile(r"\A---\n.*?^status:\s*(\S+)\s*$.*?^---\s*$", re.MULTILINE | re.DOTALL)
# Statuses that mean the owner has decided the work will be done. `idea` does not.
APPROVED_STATUSES = ("todo", "approved", "in_progress", "done")
PLACEHOLDER = "PLACEHOLDER"
DECLARED_ROOT = re.compile(r"\*\*Repository the work happens in:\*\*\s*`([^`]+)`")
BACKTICKED = re.compile(r"`([^`\n]+)`")

# A backticked token is treated as a path only when it contains a directory
# separator and ends in one of these. Extension-less tokens are command names,
# package names, or route stubs, and are not checked.
PATH_SUFFIXES = (
    ".md", ".ts", ".tsx", ".js", ".mjs", ".astro", ".go", ".py", ".sh",
    ".json", ".yaml", ".yml", ".css", ".html", ".toml", ".rs", ".sql",
)


def git_root(start):
    try:
        out = subprocess.run(
            ["git", "-C", start, "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=10,
        )
        if out.returncode == 0:
            return out.stdout.strip()
    except Exception:
        pass
    return None


def sections(lines):
    """Map heading text (lowercased) to the list of body lines beneath it."""
    found, current, body = {}, None, []
    for line in lines:
        m = HEADING.match(line)
        if m:
            if current is not None:
                found[current] = body
            current, body = m.group(1).strip().lower(), []
        elif current is not None:
            body.append(line)
    if current is not None:
        found[current] = body
    return found


def find_section(found, *wordsets):
    """The body of the first section whose heading matches any one of the given
    word sets. Each word set is a tuple of words that must all appear in the
    heading; several are accepted because the same section is spelled differently
    by different templates ("Out of scope — do not touch" against "What must not
    be touched")."""
    for wordset in wordsets:
        for heading, body in found.items():
            if all(w in heading for w in wordset):
                return heading, body
    return None, None


def non_empty(body):
    return any(line.strip() for line in (body or []))


def candidate_paths(text):
    seen, out = set(), []
    for token in BACKTICKED.findall(text):
        token = token.strip()
        if "/" not in token or " " in token:
            continue
        if not token.endswith(PATH_SUFFIXES):
            continue
        if token.startswith(("http://", "https://")):
            continue
        if token not in seen:
            seen.add(token)
            out.append(token)
    return out


def resolve(token, roots):
    expanded = os.path.expanduser(token)
    if os.path.isabs(expanded):
        return os.path.exists(expanded)
    return any(os.path.exists(os.path.join(root, expanded)) for root in roots)


def validate(card_path, text):
    lines = text.splitlines()
    found = sections(lines)
    problems = []

    status = STATUS.search(text)
    frontmatter = FRONTMATTER_STATUS.search(text)
    if status:
        value = status.group(1).lower()
        if "awaiting" in value or "not signed off" in value:
            problems.append(f"the status line still says the card is unapproved: {status.group(1).strip()}")
        elif not any(w in value for w in ("approved", "signed off", "approuv")):
            problems.append(f"the status line does not record an approval: {status.group(1).strip()}")
    elif frontmatter:
        value = frontmatter.group(1).strip().strip("\"'").lower()
        if value not in APPROVED_STATUSES:
            problems.append(
                f"the frontmatter status is `{value}` — the card is not yet decided; "
                f"set it to one of {', '.join(APPROVED_STATUSES)} once the owner has said the work will be done"
            )
    else:
        problems.append(
            "the card records no approval — it must carry either a `**Status:**` line "
            "or a `status:` field in its frontmatter"
        )

    if PLACEHOLDER in text:
        for number, line in enumerate(lines, start=1):
            if PLACEHOLDER in line:
                problems.append(f"line {number} still carries an unfilled {PLACEHOLDER} slot: {line.strip()}")

    heading, body = find_section(found, ("out of scope",), ("must not", "touch"))
    if heading is None:
        problems.append("no section saying what must not be touched")
    elif not non_empty(body):
        problems.append(f"the section '{heading}' is empty")

    heading, body = find_section(found, ("acceptance", "criteria"))
    if heading is None:
        problems.append("no acceptance criteria section")
    elif not non_empty(body):
        problems.append(f"the section '{heading}' is empty")

    heading, body = find_section(found, ("checkpoints",))
    if heading is None:
        problems.append("no checkpoints section")
    else:
        items = [line for line in body if LIST_ITEM.match(line)]
        if not items:
            problems.append("the checkpoints section holds no checkpoints")
        for item in items:
            if not CHECKPOINT.match(item):
                problems.append(f"malformed checkpoint, expected `- [ ] N.n — text`: {item.strip()}")

    roots = [os.path.dirname(os.path.abspath(card_path))]
    declared = DECLARED_ROOT.search(text)
    if declared:
        roots.append(os.path.expanduser(declared.group(1).strip()))
    root = git_root(roots[0])
    if root:
        roots.append(root)

    for token in candidate_paths(text):
        if not resolve(token, roots):
            problems.append(f"path named in the card does not resolve: {token}")

    return problems


def write_marker(card_path, text, passed):
    stripped = "\n".join(
        line for line in text.splitlines() if line.strip() != MARKER
    ).rstrip("\n")
    new = stripped + "\n" + (f"\n{MARKER}\n" if passed else "")
    if new != text:
        with open(card_path, "w", encoding="utf-8") as fh:
            fh.write(new)
        return True
    return False


def main():
    args = [a for a in sys.argv[1:] if a != "--check"]
    check_only = "--check" in sys.argv[1:]
    if len(args) != 1:
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 2

    card_path = os.path.expanduser(args[0])
    if not card_path.endswith(".md") or not os.path.isfile(card_path):
        print(f"plan-check: not a markdown file: {card_path}", file=sys.stderr)
        return 2

    with open(card_path, encoding="utf-8") as fh:
        text = fh.read()

    problems = validate(card_path, text)

    if problems:
        print(f"plan-check: {card_path} is not ready, {len(problems)} problem(s):")
        for p in problems:
            print(f"  - {p}")
        if not check_only and write_marker(card_path, text, False):
            print("  (an existing pass marker was removed)")
        return 1

    if check_only:
        print(f"plan-check: {card_path} would pass")
        return 0

    write_marker(card_path, text, True)
    print(f"plan-check: {card_path} passes; {MARKER} written")
    return 0


if __name__ == "__main__":
    sys.exit(main())
