{
  "_comment": "TEMPLATE — bootstrap.sh renders this into ~/.claude/settings.json, replacing __HOME__ with the running machine's home directory. Never edit ~/.claude/settings.json by hand: the next bootstrap overwrites it. Edit this file, commit it, and re-run bootstrap on both machines; bootstrap.sh stamps a SHA-256 digest of the rendered bytes on every clean run, so no separate version number needs to be raised by hand.",
  "permissions": {
    "allow": [],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/harness-stamp-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/settings-write-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/memory-store-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/coordinator-source-gate.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'REMINDER on writing style for THIS reply. Two tests, applied to every sentence at once. COMPREHENSION: each point is a complete sentence with a subject and a verb, understandable by a reader who does not hold this conversation in their head — never telegraphic fragments, dropped subjects, or headline bullets. RELEVANCE: in chat, give the conclusion only — no reasoning, no citations, no statute or article numbers, no background, no caveats, no alternatives, unless Alex asked for them; if a sentence does not change what he decides or does, delete it. Depth belongs in documents, not in chat. Writing more is your default failure; writing a telegram is the failure you commit when overcorrecting.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/inbox-stop.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/git-sync-notice.sh"
          },
          {
            "type": "command",
            "command": "__HOME__/.claude/hooks/skill-mcp-refs.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash __HOME__/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false
  },
  "theme": "auto",
  "preferredNotifChannel": "kitty"
}
