{
  "_comment": "Shared settings template. bootstrap.sh renders this with bin/settings-render. Machine-local model, plugin, notification, permission and private integration choices belong in ignored .private/settings.json.",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOME__/.claude/hooks/harness-stamp-gate.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOME__/.claude/hooks/work-gate.sh"
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/websearch-gate.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOME__/.claude/hooks/settings-write-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOME__/.claude/hooks/memory-store-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOME__/.claude/hooks/coordinator-source-gate.sh"
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/knowledge-index-notice.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/inbox-stop.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOME__/.claude/hooks/git-sync-notice.sh"
          },
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/skill-mcp-refs.py"
          },
          {
            "type": "command",
            "command": "bash __HOME__/.claude/hooks/workspace-root-notice.sh"
          },
          {
            "type": "command",
            "command": "python3 __HOME__/.claude/hooks/knowledge-index-notice.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash __HOME__/.claude/statusline-command.sh"
  }
}
