#!/usr/bin/env bash
# pre-commit — the checks this configuration repository runs before every commit.
#
# It is versioned here rather than written into .git/hooks, so that both machines get
# it from the same source. It becomes live when core.hooksPath is set to the relative
# value ".githooks"; bootstrap.sh does that on every deploy, and the relative form is
# deliberate — an absolute path set on one machine silently stops running any hook at
# all on the other, with the commit still succeeding and nothing in the output naming
# the problem.
#
# Check one: no machine-specific home directory in any load-bearing file. See
# bin/path-check for what counts and what is deliberately exempt.
# Check two: every hook script still parses, and none of them differs from the last
# commit without having been installed through bin/hook-install.
# Check three: a staged hooks/work-gate.sh proves its own fitness before it can land. The
# staged bytes (not the working tree's) are run through validite-app's bin/work-refusals
# --only hook, which appends the proven fingerprint to hooks/work-gate.verified-hashes.txt —
# the committed ledger the hook itself reads FITNESS from at every tool call (HRN-41). A
# passing run's updated ledger is staged into the same commit; a failing run refuses the
# commit outright.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FAILED=0

echo "pre-commit: checking for machine-specific home directories…"
if ! "$REPO_ROOT/bin/path-check" --root "$REPO_ROOT" --staged; then
    FAILED=1
fi

echo "pre-commit: checking that every hook script parses…"
for hook in "$REPO_ROOT"/hooks/*.sh; do
    [ -f "$hook" ] || continue
    if ! bash -n "$hook" 2>/dev/null; then
        echo "pre-commit: $hook does not parse." >&2
        FAILED=1
    fi
done
for hook in "$REPO_ROOT"/hooks/*.py; do
    [ -f "$hook" ] || continue
    case "$hook" in *.test.py) continue ;; esac
    if ! python3 -m py_compile "$hook" 2>/dev/null; then
        echo "pre-commit: $hook does not parse." >&2
        FAILED=1
    fi
done

STAGED_HOOK_STATUS="$(git -C "$REPO_ROOT" diff --cached --name-status -- hooks/work-gate.sh)"
if [ -n "$STAGED_HOOK_STATUS" ] && [ "${STAGED_HOOK_STATUS:0:1}" != "D" ]; then
    REFUSALS_PROJECT="${WORK_GATE_REFUSALS_PROJECT:-$HOME/Dev/validite/validite-app}"
    if [ ! -x "$REFUSALS_PROJECT/bin/work-refusals" ]; then
        echo "pre-commit: hooks/work-gate.sh is staged, but bin/work-refusals cannot be found at $REFUSALS_PROJECT." >&2
        echo "pre-commit: set WORK_GATE_REFUSALS_PROJECT to the validite-app checkout that carries it, or commit hooks/work-gate.sh from a machine that has one." >&2
        FAILED=1
    else
        REFUSALS_BRANCH="$(git -C "$REFUSALS_PROJECT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")"
        REFUSALS_COMMIT="$(git -C "$REFUSALS_PROJECT" rev-parse --short HEAD 2>/dev/null || echo "?")"
        echo "pre-commit: proving staged hooks/work-gate.sh against $REFUSALS_PROJECT (branch $REFUSALS_BRANCH @ $REFUSALS_COMMIT)…"
        STAGED_HOOK_TMP="$(mktemp)"
        git -C "$REPO_ROOT" show ":hooks/work-gate.sh" > "$STAGED_HOOK_TMP"
        if WORK_GATE_HOOK="$STAGED_HOOK_TMP" \
           WORK_GATE_LEDGER_PATH="$REPO_ROOT/hooks/work-gate.verified-hashes.txt" \
           "$REFUSALS_PROJECT/bin/work-refusals" --only hook; then
            git -C "$REPO_ROOT" add "hooks/work-gate.verified-hashes.txt"
        else
            echo "pre-commit: bin/work-refusals --only hook refused the staged hooks/work-gate.sh; commit refused." >&2
            FAILED=1
        fi
        rm -f "$STAGED_HOOK_TMP"
    fi
fi

if [ "$FAILED" -ne 0 ]; then
    echo >&2
    echo "pre-commit: refusing the commit. Fix what is named above and commit again." >&2
    exit 1
fi

echo "pre-commit: all checks passed."
exit 0
